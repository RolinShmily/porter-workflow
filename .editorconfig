# Editor defaults for this repository. No editor is required; this only keeps
# whitespace, encoding and final newlines consistent across contributors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Trailing spaces are meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
